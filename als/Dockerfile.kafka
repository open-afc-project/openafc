# Dockerfile for Kafka server, used by ALS (AFC Request/Response/Config) logging
# Uses the official Apache Kafka image (apache/kafka) in KRaft mode (no ZooKeeper).
#
# Vulnerability notes:
#   Pending upstream patch for authorization issue.
#   Accepted pending upstream patch; review group ACLs to limit grants to least-privilege principals.

From apache/kafka:4.2.0@sha256:9516fb7634bad307d17c33b589fde9023003b0cb761374f500002b980a3149b9


# Outside configuration variables
ENV KAFKA_ADVERTISED_HOST=localhost
ENV KAFKA_CLIENT_PORT=9092
ENV KAFKA_BROKER_PORT=9093
ENV KAFKA_CLIENT_SECURITY_PROTOCOL=PLAINTEXT

# Apache Kafka configuration parameters (mapped to kafka config keys via KAFKA_ prefix)
ENV KAFKA_PROCESS_ROLES=broker,controller
ENV KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
ENV KAFKA_BROKER_ID=1
# Topic initialisation and broker configuration are handled by the entrypoint script.
ENV KAFKA_NUM_PARTITIONS=1
ENV KAFKA_MAX_REQUEST_SIZE=1048576
ENV KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# Setting Kafka log level to ERROR limits initialization blurt.
# Kafka 4.x uses log4j2.yaml (YAML format) instead of the legacy log4j.properties.
# KafkaDockerWrapper copies /etc/kafka/docker/ → /opt/kafka/config/ at startup;
# we patch both the source template and the pre-seeded config so the change is active
# immediately and also survives any future container restart.
ENV KAFKA_LOG_LEVEL=ERROR
RUN for f in /etc/kafka/docker/log4j2.yaml /opt/kafka/config/log4j2.yaml; do \
      sed -i "/- name: kafka$/{n;s/level:.*/level: ERROR/}" "$f" && \
      sed -i "/- name: org\.apache\.kafka$/{n;s/level:.*/level: ERROR/}" "$f"; \
    done

# Custom entrypoint: initialises canonical ALS topics and applies hardened broker settings.
COPY --chmod=755 kafka-entrypoint.sh /etc/kafka/docker/kafka-entrypoint.sh

USER appuser
ENTRYPOINT ["/etc/kafka/docker/kafka-entrypoint.sh"]
