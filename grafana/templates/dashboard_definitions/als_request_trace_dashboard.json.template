          "rawQuery": true,
          "rawSql": "SELECT am.rx_time, ROUND(EXTRACT(EPOCH FROM (am.tx_time - am.rx_time))::numeric, 3) as duration_sec, srv.afc_server_name as server, dd.serial_number, cust.customer_name as region, rr.response_code, rr.response_description, rr.response_data, host(am.ap_ip) as ap_ip, loc.location_type as loc_type, ROUND(ST_Y(loc.location_wgs84::geometry)::numeric, 5) as latitude, ROUND(ST_X(loc.location_wgs84::geometry)::numeric, 5) as longitude, loc.height_m, CASE am.runtime_opt & 1 WHEN 1 THEN 'GUI' ELSE '' END as gui FROM afc_message am JOIN afc_server srv ON am.afc_server = srv.afc_server_id AND am.month_idx = srv.month_idx LEFT JOIN request_response_in_message rrim ON am.message_id = rrim.message_id AND am.month_idx = rrim.month_idx LEFT JOIN request_response rr ON rrim.request_response_digest = rr.request_response_digest AND rrim.month_idx = rr.month_idx LEFT JOIN device_descriptor dd ON rr.device_descriptor_digest = dd.device_descriptor_digest AND rr.month_idx = dd.month_idx LEFT JOIN customer cust ON rr.customer_id = cust.customer_id AND rr.month_idx = cust.month_idx LEFT JOIN location loc ON rr.location_digest = loc.location_digest AND rr.month_idx = loc.month_idx WHERE $__timeFilter(am.rx_time) ORDER BY am.rx_time DESC LIMIT 500",
