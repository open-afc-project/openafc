#
# Full transitive dependency tree with sha256 hashes (pip --require-hashes
# needs a hash for every package that gets installed, not just direct pins).
# Hash-pinned via (must match grafana/Dockerfile-grafana's base image glibc/
# Python ABI, NOT Alpine/musl -- this image is Ubuntu-based):
#   docker run --rm --user root --entrypoint bash
#     -v "$(pwd)/grafana:/reqlock:ro"
#     grafana/grafana:12.4.2-ubuntu -c
#     "apt-get update -qq && apt-get -y install -qq python3-minimal python3-pip &&
#      pip3 download -q --no-cache-dir --dest /p -r /reqlock/requirements-grafana.txt &&
#      for f in /p/*.whl /p/*.tar.gz; do [ -f \"\$f\" ] || continue;
#        n=\$(basename \"\$f\"); h=\$(sha256sum \"\$f\" | cut -d' ' -f1);
#        printf '%s sha256:%s\n' \"\$n\" \"\$h\"; done"
#

