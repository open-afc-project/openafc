# Grafana Alloy — replaces Promtail (EOL March 2, 2026) for Docker log
# collection and shipping to Loki.

FROM grafana/alloy:v1.16.1@sha256:51aeb9d829239345070619dad3edd6873186f913c84f45b365b74574fcb38ec0

# Loki push URL
ENV GRAFANA_DS_LOKI_URL=http://loki:3100

# Docker Compose project name for container label filtering
# ENV GRAFANA_COMPOSE_PROJECT_NAME

COPY alloy-config.alloy /etc/alloy/config.alloy

# Alloy HTTP server serves component-graph UI, /metrics, debug endpoints.
# Nginx proxies /fbrat/alloy/ to alloy:12345 for Super role.
ENTRYPOINT ["alloy", "run", "--server.http.listen-addr=0.0.0.0:12345", "/etc/alloy/config.alloy"]
