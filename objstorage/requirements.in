# Hash-pinned via:
#   docker run --rm -v "$(pwd)/objstorage/requirements.txt:/req.txt:ro"
#     python:3.12-alpine sh -c
#     "pip download -q --no-cache-dir --dest /p -r /req.txt 2>/dev/null &&
#      for f in /p/*.whl /p/*.tar.gz; do [ -f \"\$f\" ] || continue;
#        n=\$(basename \"\$f\"); h=\$(sha256sum \"\$f\" | cut -d' ' -f1);
#        printf '%s sha256:%s\n' \"\$n\" \"\$h\"; done"
#
