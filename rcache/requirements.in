#
# Hash-pinned via `pip download --dest /tmp/pkgs -r requirements.txt`
# then sha256sum for each artifact (python:3.12-alpine, musllinux_1_2_x86_64).
# Regenerate with:
#   docker run --rm -v "$(pwd)/rcache/requirements.txt:/req.txt:ro"
#     python:3.12-alpine sh -c
#     "pip download -q --no-cache-dir --dest /p -r /req.txt 2>/dev/null &&
#      for f in /p/*.whl /p/*.tar.gz; do
#        [ -f \"\$f\" ] || continue
#        n=\$(basename \"\$f\")
#        h=\$(sha256sum \"\$f\" | cut -d' ' -f1)
#        echo \"  \$n: sha256:\$h\"
#      done"
# then rebuild the hash lines below.
