# --------------------------------------------------- #
# docker-compose.yaml variables                       #
# convention: Host volume VOL_H_XXX will be mapped    #
# as container's volume VOL_C_YYY                     #
# VOL_H_XXX:VOL_C_YYY                                 #
# --------------------------------------------------- #

# Docker Compose project name — used by Grafana/Alloy/Promtail to filter
# containers belonging to this stack. Must be set explicitly so that
# ${COMPOSE_PROJECT_NAME} expands correctly in docker-compose.yaml.
# Change this if you run multiple deployments on the same host.
COMPOSE_PROJECT_NAME=open-afc

# Image tag for all first-party service images.
# Must be set explicitly; docker-compose.yaml does not fall back to :latest
# so that an unset TAG fails clearly rather than pulling an unreviewed image.
TAG=latest

# -= MUST BE defined =-
# Host static DB root dir
VOL_H_DB=/opt/afc/databases/rat_transfer

# Container's static DB root dir (dont change it !)
VOL_C_DB=/mnt/nfs/rat_transfer

# Service handling AFC Requests - msghnd or afcserver
AFC_REQ_SERVER=afcserver
AFC_REQ_SERVER_PORT=8000

# -=RAT SERVER CONFIG=-
AFC_WEBUI_NAME=rat_server

# AFC service external IP for the whole project to which the external port will be bound
# EXT_IP=0.0.0.0

# -= ALS CONFIGURATION STUFF =-

# Port on which ALS Kafka server listens for clients
ALS_KAFKA_CLIENT_PORT=9092

# ALS Kafka server host name
ALS_KAFKA_SERVER=als_kafka

# Maximum ALS message size (default 1MB is too tight for GUI AFC Response)
ALS_KAFKA_MAX_REQUEST_SIZE=10485760

# Name of ALS Kafka topic
AFC_ALS_TOPIC_NAME=ALS

# Prefix for topic names of JSON log records
AFC_JSON_TOPIC_PREFIX=


# -= RCACHE SERVICE CONFIGURATION STUFF =-

# True (1, t, on, y, yes) to enable use of Rcache. False (0, f, off, n, no) to
# use legacy file-based cache. Default is True
# Note: If AFC_REQ_SERVER=afcserver is used above, RCACHE_ENABLED must be True
RCACHE_ENABLED=True

# Port Rcache service listens os
RCACHE_CLIENT_PORT=8000
# Rcache database DSN
RCACHE_POSTGRES_DSN=postgresql://bulk_rw@bulk_postgres/rcache
# The real RabbitMQ rcache password is in the RCACHE_RMQ_PWD secret file;
# keep placeholder ("x") in the DSN — services substitute it at startup.
RCACHE_RMQ_DSN=amqp://rcache:x@rmq:5672/rcache
# Comma-separated list of request vendor extensions containing AFC State, to be
# passed from Rcache to AFC Engine for invalidated requests
AFC_STATE_VENDOR_EXTENSIONS=openAfc.engineState

# Object Storage conf
AFC_OBJST_HOST=objst
AFC_OBJST_PORT=5000
AFC_OBJST_SCHEME=HTTP

# RabbitMQ Broker conf
BROKER_TYPE=external
BROKER_FQDN=rmq
BROKER_USER=celery
# BROKER_PWD is a Docker secret — set it in secrets/BROKER_PWD (see SECURITY.md).

# -= SECRETS STUFF =-
# Host directory containing secret files
VOL_H_SECRETS=../../secrets

# Directory inside container where to secrets are mounted (always /run/secrets
# in Compose, may vary in Kubernetes)
VOL_C_SECRETS=/run/secrets

# Enable monitoring UIs (Grafana, Prometheus, cAdvisor, RabbitMQ, Kafka UI)
AFC_GRAFANA_ENABLED=false

# Compose profiles to activate. Comma-separated list of:
#   monitor  - Grafana, Prometheus, cAdvisor, Loki, Promtail, Nginx exporter, Kafka UI
#   msghnd   - message handler (alternative request server)
# Leave empty or comment out to run core AFC services only.
# Examples:
#   COMPOSE_PROFILES=monitor
#   COMPOSE_PROFILES=monitor,msghnd
#COMPOSE_PROFILES=

# Docker daemon data-root (default: /var/lib/docker).
# Override when dockerd uses a non-standard path (check: docker info --format '{{.DockerRootDir}}').
# cAdvisor mounts only the overlay2 layerdb sub-tree for mount-id resolution;
# the overlay2 merged rootfs is never exposed.
#DOCKER_DATA_ROOT=/var/lib/docker

# -= INTERNAL CLUSTER TOKEN =-
# AFC_INTERNAL_TOKEN is a Docker secret — set it in secrets/AFC_INTERNAL_TOKEN (see SECURITY.md).
