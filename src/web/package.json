{
  "name": "fbrat-web",
  "version": "0.0.0",
  "description": "AFC Web GUI",
  "license": "The use of this software shall be governed by the terms and conditions of the OpenAFC Project License.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "build": "webpack --config webpack.prod.js --stats minimal",
    "build-dev": "webpack --config webpack.dev.js --stats normal",
    "build-prod": "webpack --config webpack.prod.js --stats normal",
    "build-docs": "typedoc --out docs --ignoreCompilerErrors src/app",
    "start": "webpack-dev-server --hot --watch --color --progress --config webpack.dev.js",
    "test": "jest",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "build:bundle-profile": "webpack --profile --json > stats.json",
    "bundle-profile:analyze": "yarn build:bundle-profile && webpack-bundle-analyzer ./stats.json",
    "clean": "rimraf www"
  },
  "dependencies": {
    "@patternfly/react-core": "^6.4.0",
    "@patternfly/react-icons": "^6.4.0",
    "@patternfly/react-styles": "^6.4.0",
    "@patternfly/react-table": "^6.4.0",
    "@patternfly/react-tokens": "^6.4.0",
    "axios": "^1.13.2",
    "ejs": "^3.1.10",
    "google-map-react": "^2.2.1",
    "highlight.js": "^11.6.0",
    "jsdom": "^25.0.1",
    "konva": "^10.0.0",
    "lodash": "^4.17.21",
    "node-fetch": "^3.2.10",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-google-recaptcha": "^3.1.0",
    "react-konva": "^19.0.0",
    "react-measure": "^2.5.2",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.0.0",
    "regenerator-runtime": "^0.14.1",
    "terser": "^5.39.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/google-map-react": "^2.1.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-measure": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "html-webpack-plugin": "^5.6.5",
    "imagemin": "^7.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.3.2",
    "ts-loader": "^9.5.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.8.3",
    "webdav": "^5.8.1",
    "webpack": "^5.104.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1"
  },
  "resolutions": {
    "js-yaml": "^4.1.1",
    "lodash": "4.17.21"
  }
