{
  "name": "fbrat-web",
  "version": "0.0.0",
  "description": "AFC Web GUI",
  "license": "The use of this software shall be governed by the terms and conditions of the OpenAFC Project License.",
  "main": "index.js",
  "private": true,
  "_dependencyHolds": {
    "eslint": "pinned at ^9 — upgrading to 10 requires coordinated bumps of @typescript-eslint/* (8→9) and eslint-plugin-react-hooks (7→future). Revisit when those ecosystem packages publish eslint-10-compatible majors."
  },
  "scripts": {
    "build": "webpack --config webpack.prod.js --stats minimal",
    "build-dev": "webpack --config webpack.dev.js --stats normal",
    "build-prod": "webpack --config webpack.prod.js --stats normal",
    "build-docs": "typedoc --out docs --ignoreCompilerErrors src/app",
    "start": "webpack-dev-server --hot --watch --color --progress --config webpack.dev.js",
    "test": "jest",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "build:bundle-profile": "webpack --profile --json > stats.json",
    "bundle-profile:analyze": "yarn build:bundle-profile && webpack-bundle-analyzer ./stats.json",
    "clean": "rimraf www"
  },
  "dependencies": {
    "@patternfly/react-core": "^6.5.1",
    "@patternfly/react-icons": "^6.5.1",
    "@patternfly/react-styles": "^6.5.1",
