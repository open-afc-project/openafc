const path = require("path");
const { merge } = require("webpack-merge");
const common = require("@ADD_DIST_LIB_SOURCECOPY@/webpack.common.js");
const MiniCssExtractPlugin = require("mini-css-extract-plugin");
const CssMinimizerPlugin = require("css-minimizer-webpack-plugin");
const TerserPlugin = require("terser-webpack-plugin");
const HtmlWebpackPlugin = require("html-webpack-plugin");


module.exports = merge(common, {
  mode: "production",
  optimization: {
    minimizer: [
      new CssMinimizerPlugin(),
      new TerserPlugin({
        parallel: true,
        terserOptions: {
          mangle: true
        }
      })
    ],
  },
  plugins: [
    new HtmlWebpackPlugin({
      template: "@ADD_DIST_LIB_SOURCECOPY@/src/index.html",
      title: "AFC"
    }),
    new MiniCssExtractPlugin({
      filename: "[name].css",
      chunkFilename: "[name].bundle.css"
    })
  ],
  module: {
    rules: [
      {
        // @patternfly/react-styles declares sideEffects:["*.css"] in package.json,
        // which implicitly marks .mjs files as side-effect-free. That causes webpack
        // to tree-shake the `import './page.css'` calls inside every .mjs module,
        // so no component CSS ever gets injected.  This rule overrides that declaration
        // for the react-styles CSS namespace so the CSS imports are preserved.
        include: /node_modules\/@patternfly\/react-styles\/css\//,
        sideEffects: true,
      },
      {
        test: /\.css$/,
        include: (input) => {
          // Match CSS files from src directory
          if (input.indexOf("@ADD_DIST_LIB_SOURCECOPY@/src") !== -1) {
            return true;
          }
          // Match CSS files from patternfly packages (including nested node_modules)
          if (input.indexOf("@patternfly/react-styles/css") !== -1 ||
              input.indexOf("@patternfly/react-core") !== -1 ||
              input.indexOf("@patternfly/patternfly") !== -1 ||
              input.indexOf("/node_modules/patternfly") !== -1) {
            return true;
          }
          return false;
        },
        use: [MiniCssExtractPlugin.loader, "css-loader"]
      }
    ]
  }
});
